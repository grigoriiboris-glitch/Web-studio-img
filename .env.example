# Copy to .env before starting either compose file.
# Never commit real credentials or API keys.
APP_ENV=development
APP_PORT=8080
WEB_STATIC_DIR=
STORAGE_PROVIDER=s3
STORAGE_LOCAL_DIR=/data/assets
STORAGE_SIGNING_SECRET=
DATABASE_URL=postgres://webstudio:webstudio@postgres:5432/webstudio?sslmode=disable
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_REGION=ru-central1
S3_BUCKET=web-studio
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniosecret
S3_PATH_STYLE=true
JWT_SECRET=change-this-development-secret-to-a-random-32-character-value
CLAMAV_ADDR=
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
YANDEXART_ENDPOINT=https://llm.api.cloud.yandex.net
YANDEXART_OPERATION_ENDPOINT=https://operation.api.cloud.yandex.net
YANDEXART_API_KEY=
YANDEXART_FOLDER_ID=
YANDEXART_MODEL=yandex-art/latest
IMAGE_PROVIDER=comfyui
COMFYUI_ENDPOINT=http://host.docker.internal:8188
COMFYUI_MODEL=local
COMFYUI_MODEL_VERSION=
COMFYUI_WORKFLOW_JSON=
COMFYUI_WORKFLOW_PATH=
COMFYUI_TIMEOUT=10m
COMFYUI_POLL_EVERY=2s
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://backend:8080
HOST_APP_PORT=8080
HOST_FRONTEND_PORT=5173
HOST_POSTGRES_PORT=5432
HOST_REDIS_PORT=6379
HOST_MINIO_API_PORT=9000
HOST_MINIO_CONSOLE_PORT=9001
POSTGRES_DB=webstudio
POSTGRES_USER=webstudio
POSTGRES_PASSWORD=webstudio
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret
